# Scripted test double; prints MOCK on every receipt. Not a real model.
PENNY_MOCK=0
# Bifrost inference endpoint; Penny does not call providers directly.
BIFROST_BASE_URL=http://localhost:8080
# Cloud-capable virtual key, printed by bootstrap_bifrost.py.
BIFROST_VK_DEV=
# Separate virtual key restricted to Ollama.
BIFROST_VK_LOCAL=
# Provider credentials consumed by the gateway container only.
# Measured setup: Groq (primary, via the chaos proxy) + NVIDIA (fallback), both free tiers.
GROQ_API_KEY=
NVIDIA_API_KEY=
PENNY_CLOUD_PROVIDERS=groq,nvidia
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Host Ollama endpoint as seen from the gateway container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Local-only outage harness control URL.
CHAOS_PROXY_URL=http://localhost:8099
# Optional management API credential after enabling gateway dashboard auth.
BIFROST_MANAGEMENT_TOKEN=
# The bootstrap --prepare command adds BIFROST_SETUP_TOKEN automatically.
# Tiny-budget key for the spending-cap demo (filled after bootstrap).
BIFROST_VK_DEMO_TINY=
