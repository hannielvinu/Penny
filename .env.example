# Scripted test double; prints MOCK on every receipt. Not a real model.
PENNY_MOCK=0
# Bifrost inference endpoint; Penny does not call providers directly.
BIFROST_BASE_URL=http://localhost:8080
# Cloud-capable virtual key, printed by bootstrap_bifrost.py.
BIFROST_VK_DEV=
# Separate virtual key restricted to Ollama.
BIFROST_VK_LOCAL=
# Provider credentials consumed by the gateway container only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Host Ollama endpoint as seen from the gateway container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Local-only outage harness control URL.
CHAOS_PROXY_URL=http://localhost:8099
